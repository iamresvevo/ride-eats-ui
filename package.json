{
  "name": "@ride-eats/ui",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Ride Eats React components and design tokens",
  "exports": {
    ".": {
      "types": "./react/index.d.ts",
      "import": "./react/index.jsx",
      "default": "./react/index.jsx"
    },
    "./styles.css": "./css/index.css",
    "./vanilla": "./src/index.js",
    "./icon-names": "./react/icons/names.js",
    "./icon-search": "./react/icons/search.js"
  },
  "files": [
    "react",
    "src",
    "css",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "node scripts/check.mjs",
    "build": "vite build",
    "test": "node tests/run.mjs",
    "typecheck": "tsc --noEmit",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-static": "^1.66.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "types": "./react/index.d.ts",
  "homepage": "https://iamresvevo.github.io/ride-eats-ui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamresvevo/ride-eats-ui.git"
  }
}
